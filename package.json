{
	"name": "my-ink-cli",
	"version": "0.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=20.17"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx source/cli.tsx",
		"test": "prettier --check . && xo"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ink": "^6.5.1",
		"ink-select-input": "^6.2.0",
		"ink-table": "^3.1.0",
		"meow": "^14.1.0",
		"react": "^19.2.4"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.3.0",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^25.3.0",
		"@types/react": "^19.2.14",
		"@vdemedes/prettier-config": "^2.0.1",
		"prettier": "^3.8.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"xo": "^1.2.3"
	},
	"xo": {
		"semicolon": true,
		"prettier": true,
		"rules": {
			"react/prop-types": "off",
			"react/react-in-jsx-scope": "off"
		},
		"react": true
	},
	"prettier": "@vdemedes/prettier-config"
}
